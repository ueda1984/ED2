   !
+  ! Audit candidate: enumerate each orbit once, preserving legacy rank order.
+  ! Restrict to one OpenMP thread and verified commuting, basis-preserving maps.
+  subroutine try_orbit_basis(used)
+    use iso_fortran_env, only: int64
+    use input_param, only: NOS,NODmin,NODmax,THS,local_NODmax,local_spin, &
+      L1,L2,L3,L4,L5,L6,rk1,rk2,rk3,rk4,rk5,rk6, &
+      shift_1,shift_2,shift_3,shift_4,shift_5,shift_6,list_s,list_r
+    use omp_lib, only: omp_get_max_threads
+    logical, intent(out) :: used
+    integer :: periods(6),i,j,a,b,cur,cycle_len,s,count,rank,word,bit,dim,capacity,nrep
+    integer :: i1,i2,i3,i4,i5,i6
+    integer(int64) :: group_order,nwords
+    integer, allocatable :: maps(:,:),states(:),ns(:),np(:),grown_s(:)
+    integer(int64), allocatable :: visited(:)
+    logical, allocatable :: seen(:)
+    real(8), allocatable :: norms(:),grown_r(:)
+    real(8) :: p1,p2,p3,p4,p5,ro
+    complex(8) :: coef
+    used=.false.
+    periods=[L1,L2,L3,L4,L5,L6]
+    if(any(periods<1).or.THS<1) return
+    group_order=1_int64
+    do i=1,6
+      if(group_order>huge(1_int64)/periods(i))return
+      group_order=group_order*periods(i)
+    end do
+    if(group_order==1_int64)then
+      allocate(list_s(THS),list_r(THS))
+      !$omp parallel do private(i)
+      do i=1,THS
+        list_s(i)=i
+        list_r(i)=1d0
+      end do
+      used=.true.
+      return
+    end if
+    if(omp_get_max_threads()/=1)return
+    if(group_order>int(huge(1),int64))return
+    nwords=(int(THS,int64)+63_int64)/64_int64
+    if(nwords>16777216_int64)return ! <=128 MiB temporary visited bitmap
+    allocate(maps(0:NOS,6),seen(NOS))
+    maps(:,1)=shift_1;maps(:,2)=shift_2;maps(:,3)=shift_3
+    maps(:,4)=shift_4;maps(:,5)=shift_5;maps(:,6)=shift_6
+    if(any(maps(0,:)/=0))return
+    do a=1,6
+      if(any(maps(1:,a)<1).or.any(maps(1:,a)>NOS))return
+      seen=.false.
+      do i=1,NOS
+        j=maps(i,a)
+        if(seen(j))return
+        seen(j)=.true.
+        if(local_NODmax(i)/=local_NODmax(j))return
+        if(local_spin(i)/=local_spin(j))return
+      end do
+      seen=.false.
+      do i=1,NOS
+        if(seen(i))cycle
+        cur=i;cycle_len=0
+        do
+          seen(cur)=.true.;cycle_len=cycle_len+1
+          cur=maps(cur,a)
+          if(cur==i)exit
+        end do
+        if(mod(periods(a),cycle_len)/=0)return
+      end do
+      do b=1,a-1
+        do i=1,NOS
+          if(maps(maps(i,a),b)/=maps(maps(i,b),a))return
+        end do
+      end do
+    end do
+    deallocate(seen,maps)
+    dim=THS
+    capacity=int(min(int(dim,int64),max(10000_int64,2_int64*dim/group_order)))
+    allocate(visited(nwords),states(capacity),norms(capacity),ns(NODmax),np(NODmax))
+    visited=0_int64;nrep=0
+    do s=1,dim
+      word=(s-1)/64+1;bit=mod(s-1,64)
+      if(btest(visited(word),bit))cycle
+      ns=list_fly(s,NODmax,NODmin,NOS)
+      if(inv_list(ns,NODmax)/=s)return
+      np=ns;count=0;coef=(0d0,0d0)
+      do i6=1,L6
+        np=shift_6(np);p5=rk6*dble(i6)
+        do i5=1,L5
+          np=shift_5(np);p4=rk5*dble(i5)+p5
+          do i4=1,L4
+            np=shift_4(np);p3=rk4*dble(i4)+p4
+            do i3=1,L3
+              np=shift_3(np);p2=rk3*dble(i3)+p3
+              do i2=1,L2
+                np=shift_2(np);p1=rk2*dble(i2)+p2
+                do i1=1,L1
+                  np=shift_1(np)
+                  call insertion_sort(np,NODmax)
+                  rank=inv_list(np,NODmax)
+                  if(rank<s.or.rank>dim) error stop 'orbit rank inconsistent with legacy ordering'
+                  word=(rank-1)/64+1;bit=mod(rank-1,64)
+                  visited(word)=ibset(visited(word),bit)
+                  if(rank==s)then
+                    coef=coef+exp((0d0,-1d0)*(rk1*dble(i1)+p1))
+                    count=count+1
+                  end if
+                end do
+              end do
+            end do
+          end do
+        end do
+      end do
+      if(count<1) error stop 'orbit missing identity'
+      ro=(abs(coef)**2)*dble(group_order)/dble(count)
+      if(ro>1d-15)then
+        if(nrep==capacity)then
+          capacity=int(min(int(dim,int64),2_int64*capacity))
+          allocate(grown_s(capacity),grown_r(capacity))
+          grown_s(:nrep)=states(:nrep);grown_r(:nrep)=norms(:nrep)
+          call move_alloc(grown_s,states);call move_alloc(grown_r,norms)
+        end if
+        nrep=nrep+1;states(nrep)=s;norms(nrep)=sqrt(ro)
+      end if
+    end do
+    if(nrep==0)stop 'THS = 0.'
+    allocate(list_s(nrep),list_r(nrep))
+    list_s=states(:nrep);list_r=norms(:nrep);THS=nrep
+    used=.true.
+  end subroutine try_orbit_basis
+
 end module state_lists
 
